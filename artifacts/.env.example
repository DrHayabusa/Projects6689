# ASSISTRAN backend environment variables (api-server)
# Copy to .env and adjust as needed.

# Ollama server. The browser NEVER talks to Ollama directly — only the
# api-server does. Use 127.0.0.1 when Ollama runs on the SAME machine as this
# server (Ollama binds to localhost by default, so the public IP will refuse
# connections). Point this at a host:port only when Ollama is remote.
OLLAMA_URL=http://127.0.0.1:11434
# Remote example: OLLAMA_URL=http://46.152.253.223:11434

# Model used for translation. qwen2.5-coder:32b takes ~15s to respond,
# which is why the translate route uses a 120s timeout.
MODEL_NAME=qwen2.5-coder:32b

# Port the Express api-server listens on (proxy forwards /api here).
PORT=80
