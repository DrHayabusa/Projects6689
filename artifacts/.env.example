# ASSISTRAN backend environment variables (api-server)
# Copy to .env and adjust as needed.

# External Ollama server. The browser NEVER talks to Ollama directly —
# only the api-server does.
OLLAMA_URL=http://46.152.253.223:11434

# Model used for translation. qwen2.5-coder:32b takes ~15s to respond,
# which is why the translate route uses a 120s timeout.
MODEL_NAME=qwen2.5-coder:32b

# Port the Express api-server listens on (proxy forwards /api here).
PORT=80
